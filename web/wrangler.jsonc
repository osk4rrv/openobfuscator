{
  "name": "openobfuscator",
  "main": "src/cloudflare-worker.js",
  "compatibility_date": "2026-07-31",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
