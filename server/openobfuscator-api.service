[Unit]
Description=OpenObfuscator isolated API
After=network.target

[Service]
Type=simple
User=openobfuscator
Group=openobfuscator
EnvironmentFile=/etc/openobfuscator/api.env
ExecStart=/usr/bin/python3 /opt/openobfuscator/server/obfuscator_api.py
Restart=on-failure
RestartSec=3

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
UMask=0077

MemoryMax=256M
MemorySwapMax=0
CPUQuota=50%
CPUWeight=10
Nice=10
TasksMax=8
LimitNOFILE=64
LimitCORE=0
RuntimeDirectory=openobfuscator
RuntimeDirectoryMode=0700

[Install]
WantedBy=multi-user.target
